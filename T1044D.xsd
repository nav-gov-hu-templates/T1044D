<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:meta="https://api.nav.gov.hu/definitions/form_xsd_metaschema/1.0"
        xmlns:tns="https://soap.api.nav.gov.hu/definitions/model/2.0/T1044D/1.0"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        targetNamespace="https://soap.api.nav.gov.hu/definitions/model/2.0/T1044D/1.0">
   <import namespace="https://api.nav.gov.hu/definitions/form_xsd_metaschema/1.0"
           schemaLocation="form_xsd_metaschema.xsd"/>
   <element name="Doc_T1044D"
            type="tns:Doc_T1044D_Type"
            meta:metaType="DocMetaType">
      <annotation>
         <documentation>Bejelentő és változásbejelentő lap iskolaszövetkezet biztosítottnak nem minősülő, megállapodás keretében közreműködő tagjáról</documentation>
      </annotation>
   </element>
   <complexType name="Doc_T1044D_Type">
      <annotation>
         <documentation>A teljes bizonylat szerkezetet leíró típus</documentation>
      </annotation>
      <sequence>
         <element name="Form_T1044D"
                  type="tns:Form_T1044D_Type"
                  minOccurs="1"
                  maxOccurs="1"
                  meta:metaType="FormMetaType">
            <annotation>
               <documentation>T1044D részbizonylat</documentation>
            </annotation>
         </element>
      </sequence>
   </complexType>
   <simpleType name="Enum_T1044D_0BXXXXC0001AA">
      <annotation>
         <documentation>Enum értékek </documentation>
      </annotation>
      <restriction base="xs:string">
         <enumeration value="U">
            <annotation>
               <documentation>U=új bejelentés</documentation>
            </annotation>
         </enumeration>
         <enumeration value="V">
            <annotation>
               <documentation>V=változás</documentation>
            </annotation>
         </enumeration>
         <enumeration value="T">
            <annotation>
               <documentation>T=törlés</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
   <complexType name="Form_T1044D_Type">
      <annotation>
         <documentation>A teljes nyomtatvány T1044D részbiztonylatának szerkezetét leíró típus.</documentation>
      </annotation>
      <sequence>
         <element name="Block_120001"
                  type="tns:Block_T1044D_120001_Type"
                  minOccurs="0"
                  meta:metaType="BlockMetaType">
            <annotation>
               <documentation>AZONOSÍTÓ ADATOK</documentation>
            </annotation>
         </element>
         <element name="Block_120004"
                  type="tns:Block_T1044D_120004_Type"
                  minOccurs="0"
                  meta:metaType="BlockMetaType">
            <annotation>
               <documentation>Jogutódlással kapcsolatos bejelentés</documentation>
            </annotation>
         </element>
         <element name="Block_120007"
                  type="tns:Block_T1044D_120007_Type"
                  minOccurs="0"
                  meta:metaType="BlockMetaType">
            <annotation>
               <documentation>Szövetkezeti tag bejelentése, korábbi bejelentés módosítása/törlése</documentation>
            </annotation>
         </element>
      </sequence>
   </complexType>
   <complexType name="Block_T1044D_120001_Type">
      <annotation>
         <documentation>AZONOSÍTÓ ADATOK</documentation>
      </annotation>
      <all>
         <element name="FieldGroup_120002"
                  type="tns:FieldGroup_T1044D_120002_Type"
                  minOccurs="0"
                  meta:metaType="FieldGroupMetaType">
            <annotation>
               <documentation>Azonosító adatok</documentation>
            </annotation>
         </element>
      </all>
   </complexType>
   <complexType name="Block_T1044D_120004_Type">
      <annotation>
         <documentation>Jogutódlással kapcsolatos bejelentés</documentation>
      </annotation>
      <all>
         <element name="FieldGroup_120005"
                  type="tns:FieldGroup_T1044D_120005_Type"
                  minOccurs="0"
                  meta:metaType="FieldGroupMetaType">
            <annotation>
               <documentation>A jogelőd és a jogutód szövetkezet adatai</documentation>
            </annotation>
         </element>
         <element name="FieldGroup_120006"
                  type="tns:FieldGroup_T1044D_120006_Type"
                  minOccurs="0"
                  meta:metaType="FieldGroupMetaType">
            <annotation>
               <documentation>Jogutódlással kapcsolatos nyilatkozatok</documentation>
            </annotation>
         </element>
      </all>
   </complexType>
   <complexType name="Block_T1044D_120007_Type">
      <annotation>
         <documentation>Szövetkezeti tag bejelentése, korábbi bejelentés módosítása/törlése</documentation>
      </annotation>
      <all>
         <element name="Chain_120020"
                  type="tns:Chain_T1044D_120020_Type"
                  minOccurs="0"
                  meta:metaType="ChainMetaType">
            <annotation>
               <documentation>A szövetkezeti tag azonosító és jogviszony adatai</documentation>
            </annotation>
         </element>
      </all>
   </complexType>
   <complexType name="Chain_T1044D_120020_Type">
      <annotation>
         <documentation>A szövetkezeti tag azonosító és jogviszony adatai</documentation>
      </annotation>
      <sequence>
         <element name="Chain_elem" minOccurs="0" maxOccurs="999">
            <annotation>
               <documentation>Lánc ismétlődő elemei</documentation>
            </annotation>
            <complexType>
               <sequence>
                  <element name="FieldGroup_120008"
                           type="tns:FieldGroup_T1044D_120008_Type"
                           minOccurs="1"
                           meta:metaType="FieldGroupMetaType">
                     <annotation>
                        <documentation>A szövetkezeti tag azonosító és jogviszony adatai</documentation>
                     </annotation>
                  </element>
               </sequence>
            </complexType>
         </element>
      </sequence>
   </complexType>
   <complexType name="FieldGroup_T1044D_120002_Type">
      <annotation>
         <documentation>Azonosító adatok</documentation>
      </annotation>
      <all>
         <element name="Field_0A0001C0001AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Szövetkezet megnevezése ([Főlap]A1)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="75"/>
                  <pattern value="[\P{C}]*[^\s][\P{C}]*"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0A0001C0002AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Adószáma ([Főlap]A2)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="11"/>
                  <pattern value="[0-9]+"/>
               </restriction>
            </simpleType>
         </element>
      </all>
   </complexType>
   <complexType name="FieldGroup_T1044D_120005_Type">
      <annotation>
         <documentation>A jogelőd és a jogutód szövetkezet adatai</documentation>
      </annotation>
      <all>
         <element name="Field_0A0001D0005AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>megnevezése ([Főlap]A5)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="75"/>
                  <pattern value="[\P{C}]*[^\s][\P{C}]*"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0A0001D0006AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>adószáma ([Főlap]A6)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="11"/>
                  <pattern value="[0-9]+"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0A0001D0007AA"
                  minOccurs="0"
                  type="xs:date"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>megalakulásának napja ([Főlap]A7)</documentation>
            </annotation>
         </element>
         <element name="Field_0A0001D0008AA"
                  minOccurs="0"
                  type="xs:date"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>jogutódlásának napja ([Főlap]A8)</documentation>
            </annotation>
         </element>
      </all>
   </complexType>
   <complexType name="FieldGroup_T1044D_120006_Type">
      <annotation>
         <documentation>Jogutódlással kapcsolatos nyilatkozatok</documentation>
      </annotation>
      <all>
         <element name="Field_0A0001D0003AA"
                  minOccurs="0"
                  type="xs:boolean"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Jelölje, ha az új jogviszonyra vonatkozó bejelentést az Art. 1. sz. melléklet 3.3. pontja alapján a foglalkoztató iskolaszövetkezetének jogutódlása miatt nyújtja be! ([Főlap]A3)</documentation>
            </annotation>
         </element>
         <element name="Field_0A0001D0004AA"
                  minOccurs="0"
                  type="xs:boolean"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Jelölje, ha a bejelentés a jogelődnél korábban fennálló jogviszonyra / jogviszonyokra vonatkozik és visszamenőleges pótlás vagy korrekció miatt nyújtja be! ([Főlap]A4)</documentation>
            </annotation>
         </element>
      </all>
   </complexType>
   <complexType name="FieldGroup_T1044D_120008_Type">
      <annotation>
         <documentation>A szövetkezeti tag azonosító és jogviszony adatai</documentation>
      </annotation>
      <all>
         <element name="Field_0BXXXXC0001AA"
                  minOccurs="0"
                  type="tns:Enum_T1044D_0BXXXXC0001AA"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Bejelentés jellege ([p25]A1)</documentation>
            </annotation>
         </element>
         <element name="Field_0BXXXXC0002AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Hibás bejelentés iktatószáma ([p25]A2)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="10"/>
                  <pattern value="[0-9]+"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0BXXXXC0003AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Tag neve ([p25]A3)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="75"/>
                  <pattern value="[\P{C}]*[^\s][\P{C}]*"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0BXXXXC0004AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Adóazonosító jele ([p25]A4)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="10"/>
                  <pattern value="[0-9]+"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0BXXXXC0005AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Taj száma ([p25]A5)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="9"/>
                  <pattern value="[0-9]+"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0BXXXXC0005BA"
                  minOccurs="0"
                  type="xs:boolean"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Jelölje, ha a tagnak nincs tajszáma! ([p25]B5)</documentation>
            </annotation>
         </element>
         <element name="Field_0BXXXXC0006AA"
                  minOccurs="0"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Diákigazolvány azonosító száma ([p25]A6)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <minLength value="1"/>
                  <maxLength value="30"/>
                  <pattern value="[\P{C}]*[^\s][\P{C}]*"/>
               </restriction>
            </simpleType>
         </element>
         <element name="Field_0BXXXXC0007AA"
                  minOccurs="0"
                  type="xs:date"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Tagsági megállapodás megkötésének napja ([p25]A7)</documentation>
            </annotation>
         </element>
         <element name="Field_0BXXXXC0008AA"
                  minOccurs="0"
                  type="xs:date"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>A szövetkezeti tagi jogviszony megszűnésének napja ([p25]A8)</documentation>
            </annotation>
         </element>
         <element name="Field_0BXXXXC0008BA"
                  minOccurs="0"
                  type="xs:boolean"
                  meta:metaType="FieldMetaType">
            <annotation>
               <documentation>Korábban bejelentett jogviszonyt logikailag töröljük a tag vonatkozásában, mivel a foglalkoztatás nem jött létre. ([p25]B8)</documentation>
            </annotation>
         </element>
      </all>
   </complexType>
</schema>
